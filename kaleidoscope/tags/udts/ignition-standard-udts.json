    {
      "name": "_Production",
      "tagType": "Folder",
      "tags": [
        {
          "name": "ProductionLine",
          "tagType": "UdtType",
          "tags": [
            {
              "name": "OEE",
              "tagType": "Folder",
              "tags": [
                {
                  "name": "Availability",
                  "tagType": "AtomicTag",
                  "valueSource": "memory",
                  "dataType": "Float8",
                  "engUnit": "%"
                },
                {
                  "name": "Performance",
                  "tagType": "AtomicTag",
                  "valueSource": "memory",
                  "dataType": "Float8",
                  "engUnit": "%"
                },
                {
                  "name": "Quality",
                  "tagType": "AtomicTag",
                  "valueSource": "memory",
                  "dataType": "Float8",
                  "engUnit": "%"
                },
                {
                  "name": "Overall",
                  "tagType": "AtomicTag",
                  "valueSource": "expr",
                  "expression": "{Availability} * {Performance} * {Quality} / 10000",
                  "dataType": "Float8",
                  "engUnit": "%"
                }
              ]
            },
            {
              "name": "Production",
              "tagType": "Folder",
              "tags": [
                {
                  "name": "CurrentCount",
                  "tagType": "AtomicTag",
                  "valueSource": "opc",
                  "opcPath": "ns=1;s=[{Device}]{BasePath}/CurrentCount",
                  "dataType": "Int4"
                },
                {
                  "name": "TargetCount",
                  "tagType": "AtomicTag",
                  "valueSource": "memory",
                  "dataType": "Int4"
                },
                {
                  "name": "GoodCount",
                  "tagType": "AtomicTag",
                  "valueSource": "opc",
                  "opcPath": "ns=1;s=[{Device}]{BasePath}/GoodCount",
                  "dataType": "Int4"
                },
                {
                  "name": "RejectCount",
                  "tagType": "AtomicTag",
                  "valueSource": "opc",
                  "opcPath": "ns=1;s=[{Device}]{BasePath}/RejectCount",
                  "dataType": "Int4"
                },
                {
                  "name": "Rate",
                  "tagType": "AtomicTag",
                  "valueSource": "opc",
                  "opcPath": "ns=1;s=[{Device}]{BasePath}/Rate",
                  "dataType": "Float8",
                  "engUnit": "pcs/min"
                }
              ]
            },
            {
              "name": "State",
              "tagType": "AtomicTag",
              "valueSource": "opc",
              "opcPath": "ns=1;s=[{Device}]{BasePath}/State",
              "dataType": "Int4",
              "documentation": "PackML State (0=Stopped, 1=Starting, 2=Idle, 3=Suspended, 4=Execute, 5=Stopping, 6=Aborting, 7=Aborted, 8=Holding, 9=Held)"
            },
            {
              "name": "CurrentProduct",
              "tagType": "AtomicTag",
              "valueSource": "opc",
              "opcPath": "ns=1;s=[{Device}]{BasePath}/CurrentProduct",
              "dataType": "String"
            },
            {
              "name": "CurrentBatch",
              "tagType": "AtomicTag",
              "valueSource": "opc",
              "opcPath": "ns=1;s=[{Device}]{BasePath}/CurrentBatch",
              "dataType": "String"
            }
          ],
          "parameters": {
            "Device": {
              "dataType": "String",
              "value": "PLC1"
            },
            "BasePath": {
              "dataType": "String",
              "value": "Line1"
            },
            "LineName": {
              "dataType": "String",
              "value": "Production Line 1"
            }
          }
        },
        {
          "name": "PackMLState",
          "tagType": "UdtType",
          "tags": [
            {
              "name": "State",
              "tagType": "AtomicTag",
              "valueSource": "opc",
              "opcPath": "ns=1;s=[{Device}]{BasePath}/State",
              "dataType": "Int4"
            },
            {
              "name": "StateName",
              "tagType": "AtomicTag",
              "valueSource": "expr",
              "expression": "case(\n  {State},\n  0, \"Stopped\",\n  1, \"Starting\",\n  2, \"Idle\",\n  3, \"Suspended\",\n  4, \"Execute\",\n  5, \"Stopping\",\n  6, \"Aborting\",\n  7, \"Aborted\",\n  8, \"Holding\",\n  9, \"Held\",\n  10, \"Unholding\",\n  11, \"Suspending\",\n  12, \"Unsuspending\",\n  13, \"Resetting\",\n  14, \"Completing\",\n  15, \"Complete\",\n  \"Unknown\"\n)",
              "dataType": "String"
            },
            {
              "name": "Commands",
              "tagType": "Folder",
              "tags": [
                {
                  "name": "Start",
                  "tagType": "AtomicTag",
                  "valueSource": "opc",
                  "opcPath": "ns=1;s=[{Device}]{BasePath}/Commands/Start",
                  "dataType": "Boolean"
                },
                {
                  "name": "Stop",
                  "tagType": "AtomicTag",
                  "valueSource": "opc",
                  "opcPath": "ns=1;s=[{Device}]{BasePath}/Commands/Stop",
                  "dataType": "Boolean"
                },
                {
                  "name": "Hold",
                  "tagType": "AtomicTag",
                  "valueSource": "opc",
                  "opcPath": "ns=1;s=[{Device}]{BasePath}/Commands/Hold",
