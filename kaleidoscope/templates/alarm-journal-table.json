{
  "id": "alarm-journal-table",
  "name": "Perspective Alarm Journal Table",
  "description": "Perspective Alarm Journal Table - displays alarm system history with filtering, date range selection, and customizable columns",
  "version": "1.0.0",
  "author": "GitWay",
  "category": "Alarm",
  "ignitionComponent": "perspective.alarm-journal-table",
  "parameters": {
    "name": {
      "type": "string",
      "required": false,
      "default": "Journal",
      "description": "Alarm Journal name to query"
    },
    "refreshRate": {
      "type": "number",
      "required": false,
      "default": 5000,
      "description": "Refresh rate in milliseconds"
    },
    "dateRangeMode": {
      "type": "string",
      "required": false,
      "default": "realtime",
      "enum": ["realtime", "historical"],
      "description": "Date range mode"
    },
    "realtimeInterval": {
      "type": "number",
      "required": false,
      "default": 1,
      "description": "Realtime interval amount"
    },
    "realtimeUnit": {
      "type": "string",
      "required": false,
      "default": "hours",
      "enum": ["seconds", "minutes", "hours", "days", "months", "years"],
      "description": "Realtime interval unit"
    },
    "historicalStartDate": {
      "type": "number",
      "required": false,
      "default": null,
      "description": "Historical start date in milliseconds"
    },
    "historicalEndDate": {
      "type": "number",
      "required": false,
      "default": null,
      "description": "Historical end date in milliseconds"
    },
    "enableDetails": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Enable details action for events"
    },
    "enableHeader": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Show table header"
    },
    "dateFormat": {
      "type": "string",
      "required": false,
      "default": "datetime",
      "enum": ["none", "date", "time", "datetime"],
      "description": "Date column format"
    },
    "dragOrderable": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Enable drag to reorder columns"
    },
    "filterActive": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Filter: Show active events"
    },
    "filterAcked": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Filter: Show acknowledged events"
    },
    "filterCleared": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Filter: Show cleared events"
    },
    "filterEnabled": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Filter: Show enabled events"
    },
    "filterDisabled": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Filter: Show disabled events"
    },
    "filterSystem": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Filter: Show system events"
    },
    "filterDiagnostic": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Filter: Show diagnostic priority"
    },
    "filterLow": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Filter: Show low priority"
    },
    "filterMedium": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Filter: Show medium priority"
    },
    "filterHigh": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Filter: Show high priority"
    },
    "filterCritical": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Filter: Show critical priority"
    },
    "filterSource": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Filter by source path (comma-separated, wildcard support)"
    },
    "filterDisplayPath": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Filter by display path (comma-separated, wildcard support)"
    },
    "filterProvider": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Filter by provider name"
    },
    "enableToolbar": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Show toolbar"
    },
    "enableDateRangeSelector": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Show date range selector in toolbar"
    },
    "enableFilter": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Show filter in toolbar"
    },
    "toggleableFilter": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Allow toggling filter visibility"
    },
    "enableFilterResults": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Show filter results count"
    },
    "enablePreFilters": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Show priority/state pre-filters"
    },
    "enableConfiguration": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Show configuration button"
    },
    "enablePager": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Enable pagination"
    },
    "hidePager": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Hide pager when enabled"
    },
    "pagerOptions": {
      "type": "array",
      "required": false,
      "default": [10, 25, 50, 100],
      "description": "Page size options"
    },
    "initialPageSize": {
      "type": "number",
      "required": false,
      "default": 25,
      "description": "Initial page size"
    },
    "enableResponsive": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Enable responsive card layout"
    },
    "responsiveBreakpoint": {
      "type": "number",
      "required": false,
      "default": 768,
      "description": "Responsive breakpoint in pixels"
    }
  },
  "view": {
    "type": "alarmJournalTable",
    "props": {
      "style": {
        "width": "100%",
        "height": "600px"
      },
      "name": "{{params.name}}",
      "refreshRate": "{{params.refreshRate}}",
      "enableHeader": "{{params.enableHeader}}",
      "enableDetails": "{{params.enableDetails}}",
      "dateFormat": "{{params.dateFormat}}",
      "dragOrderable": "{{params.dragOrderable}}",
      "dateRange": {
        "mode": "{{params.dateRangeMode}}",
        "realtime": {
          "interval": "{{params.realtimeInterval}}",
          "unit": "{{params.realtimeUnit}}"
        },
        "historical": {
          "startDate": "{{params.historicalStartDate}}",
          "endDate": "{{params.historicalEndDate}}"
        }
      },
      "filter": {
        "text": "",
        "events": {
          "active": "{{params.filterActive}}",
          "acked": "{{params.filterAcked}}",
          "cleared": "{{params.filterCleared}}",
          "enabled": "{{params.filterEnabled}}",
          "disabled": "{{params.filterDisabled}}",
          "system": "{{params.filterSystem}}"
        },
        "priorities": {
          "diagnostic": "{{params.filterDiagnostic}}",
          "low": "{{params.filterLow}}",
          "medium": "{{params.filterMedium}}",
          "high": "{{params.filterHigh}}",
          "critical": "{{params.filterCritical}}"
        },
        "conditions": {
          "source": "{{params.filterSource}}",
          "displayPath": "{{params.filterDisplayPath}}",
          "provider": "{{params.filterProvider}}"
        },
        "results": {
          "enabled": false,
          "data": []
        }
      },
      "columns": {
        "eventTime": {
          "enabled": true,
          "width": 180,
          "strictWidth": false,
          "sort": "descending"
        },
        "eventId": {
          "enabled": false,
          "width": 100,
          "strictWidth": false,
          "sort": "none"
        },
        "name": {
          "enabled": true,
          "width": 150,
          "strictWidth": false,
          "sort": "none"
        },
        "source": {
          "enabled": true,
          "width": 200,
          "strictWidth": false,
          "sort": "none"
        },
        "eventState": {
          "enabled": true,
          "width": 120,
          "strictWidth": false,
          "sort": "none"
        },
        "priority": {
          "enabled": true,
          "width": 100,
          "strictWidth": false,
          "sort": "none"
        },
        "state": {
          "enabled": true,
          "width": 120,
          "strictWidth": false,
          "sort": "none"
        },
        "displayPath": {
          "enabled": false,
          "width": 200,
          "strictWidth": false,
          "sort": "none"
        },
        "label": {
          "enabled": false,
          "width": 150,
          "strictWidth": false,
          "sort": "none"
        },
        "eventValue": {
          "enabled": false,
          "width": 100,
          "strictWidth": false,
          "sort": "none"
        },
        "isSystemEvent": {
          "enabled": false,
          "width": 100,
          "strictWidth": false,
          "sort": "none"
        },
        "ackUser": {
          "enabled": true,
          "width": 120,
          "strictWidth": false,
          "sort": "none"
        },
        "ackNotes": {
          "enabled": false,
          "width": 200,
          "strictWidth": false,
          "sort": "none"
        }
      },
      "columnsAssociated": [],
      "sortOrder": ["eventTime"],
      "toolbar": {
        "enabled": "{{params.enableToolbar}}",
        "enableDateRange": "{{params.enableDateRangeSelector}}",
        "enableFilter": "{{params.enableFilter}}",
        "toggleableFilter": "{{params.toggleableFilter}}",
        "enableFilterResults": "{{params.enableFilterResults}}",
        "enablePreFilters": "{{params.enablePreFilters}}",
        "enableConfiguration": "{{params.enableConfiguration}}"
      },
      "pager": {
        "enabled": "{{params.enablePager}}",
        "hide": "{{params.hidePager}}",
        "options": "{{params.pagerOptions}}",
        "initialOption": "{{params.initialPageSize}}",
        "activePage": 1
      },
      "responsive": {
        "enabled": "{{params.enableResponsive}}",
        "breakpoint": "{{params.responsiveBreakpoint}}"
      },
      "rowStyles": {
        "activeUnacked": {
          "base": {
            "backgroundColor": "#ffebee",
            "color": "#c62828",
            "fontWeight": "600"
          },
          "priorities": {
            "diagnostic": {
              "backgroundColor": "#f5f5f5",
              "color": "#616161"
            },
            "low": {
              "backgroundColor": "#fff9c4",
              "color": "#f57f17"
            },
            "medium": {
              "backgroundColor": "#ffe0b2",
              "color": "#e65100"
            },
            "high": {
              "backgroundColor": "#ffccbc",
              "color": "#d84315"
            },
            "critical": {
              "backgroundColor": "#ffebee",
              "color": "#c62828"
            }
          }
        },
        "activeAcked": {
          "backgroundColor": "#e8eaf6",
          "color": "#283593"
        },
        "clearUnacked": {
          "backgroundColor": "#fff3e0",
          "color": "#e65100"
        },
        "clearAcked": {
          "backgroundColor": "#e8f5e9",
          "color": "#2e7d32"
        },
        "dateFormat": "yyyy-MM-dd HH:mm:ss"
      },
      "events": {
        "onSelectionChange": {
          "script": ""
        }
      }
    }
  }
}
