{
  "id": "xy-chart",
  "name": "XY Chart",
  "description": "Perspective XY Chart - displays data trends with flexible timeseries or X-Y data configuration",
  "version": "1.0.0",
  "author": "GitWay",
  "category": "Chart",
  "ignitionComponent": "perspective.chart.xy",
  "parameters": {
    "title": {
      "type": "string",
      "required": false,
      "default": "XY Chart",
      "description": "Chart title text"
    },
    "subtitle": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Chart subtitle text"
    },
    "dataSources": {
      "type": "array",
      "required": true,
      "description": "Objects that are the data source for the chart",
      "example": [
        {
          "name": "dataSource1",
          "data": [
            {"x": 0, "y": 10},
            {"x": 1, "y": 15},
            {"x": 2, "y": 13}
          ]
        }
      ]
    },
    "enableTransitions": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Enable animation transitions"
    },
    "showLegend": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Display chart legend"
    },
    "legendPosition": {
      "type": "string",
      "required": false,
      "default": "bottom",
      "description": "Legend position",
      "options": ["left", "right", "top", "bottom", "absolute"]
    },
    "cursorEnabled": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Enable cursor line"
    },
    "selectionEnabled": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Enable data point selection (v8.1.10+)"
    },
    "backgroundType": {
      "type": "string",
      "required": false,
      "default": "none",
      "description": "Background rendering type",
      "options": ["none", "gradient", "color"]
    }
  },
  "view": {
    "type": "card",
    "props": {
      "title": "{{params.title}}",
      "style": {
        "width": "100%",
        "minWidth": "600px",
        "minHeight": "400px"
      }
    },
    "children": [
      {
        "type": "xyChart",
        "props": {
          "dataSources": "{{params.dataSources}}",
          "enableTransitions": "{{params.enableTransitions}}",
          "style": {
            "width": "100%",
            "height": "100%"
          },
          "config": {
            "title": {
              "text": "{{params.title}}",
              "visible": true,
              "font": {
                "size": 16,
                "color": "#333333"
              }
            },
            "subtitle": {
              "text": "{{params.subtitle}}",
              "visible": "{{params.subtitle !== ''}}",
              "font": {
                "size": 12,
                "color": "#666666"
              }
            },
            "legend": {
              "enabled": "{{params.showLegend}}",
              "position": "{{params.legendPosition}}",
              "markers": {
                "width": 12,
                "height": 12,
                "stroke": {
                  "width": 1,
                  "color": "#333333"
                },
                "cornerRadius": 0
              },
              "labels": {
                "template": "{name}",
                "font": {
                  "size": 12,
                  "color": "#333333"
                }
              }
            },
            "cursor": {
              "enabled": "{{params.cursorEnabled}}",
              "series": "",
              "lineX": {
                "stroke": {
                  "color": "#000000",
                  "width": 1,
                  "opacity": 1,
                  "dashArray": "3,3"
                }
              },
              "lineY": {
                "stroke": {
                  "color": "#000000",
                  "width": 1,
                  "opacity": 1,
                  "dashArray": "3,3"
                }
              }
            },
            "selection": {
              "enabled": "{{params.selectionEnabled}}",
              "data": [],
              "selectedHighlightColor": "#3b82f6"
            },
            "background": {
              "type": "{{params.backgroundType}}",
              "color": "#ffffff"
            },
            "scrollBars": {
              "horizontal": {
                "enabled": false
              },
              "vertical": {
                "enabled": false
              }
            },
            "xAxes": [
              {
                "name": "xAxis1",
                "type": "value",
                "position": "bottom",
                "label": {
                  "text": "X Axis",
                  "visible": true,
                  "font": {
                    "size": 12,
                    "color": "#333333"
                  }
                },
                "grid": {
                  "visible": true,
                  "stroke": {
                    "color": "#e5e7eb",
                    "width": 1,
                    "opacity": 1
                  }
                },
                "renderer": {
                  "opposite": false,
                  "inside": false
                }
              }
            ],
            "yAxes": [
              {
                "name": "yAxis1",
                "type": "value",
                "position": "left",
                "label": {
                  "text": "Y Axis",
                  "visible": true,
                  "font": {
                    "size": 12,
                    "color": "#333333"
                  }
                },
                "grid": {
                  "visible": true,
                  "stroke": {
                    "color": "#e5e7eb",
                    "width": 1,
                    "opacity": 1
                  }
                },
                "renderer": {
                  "opposite": false,
                  "inside": false
                }
              }
            ],
            "series": [
              {
                "name": "series1",
                "type": "line",
                "visible": true,
                "hiddenInLegend": false,
                "data": {
                  "source": "dataSource1",
                  "x": "x",
                  "y": "y"
                },
                "xAxis": "xAxis1",
                "yAxis": "yAxis1",
                "zIndex": 0,
                "appearance": {
                  "stroke": {
                    "width": 2,
                    "opacity": 1,
                    "color": "#3b82f6",
                    "dashArray": ""
                  },
                  "fill": {
                    "color": "#3b82f6",
                    "opacity": 0.3
                  },
                  "bullets": {
                    "enabled": false,
                    "render": "circle",
                    "width": 8,
                    "height": 8
                  },
                  "connect": true,
                  "tensionX": 1,
                  "tensionY": 1,
                  "minDistance": 0.5
                },
                "tooltip": {
                  "enabled": true,
                  "template": "{name}: {valueY}"
                },
                "label": {
                  "text": "Series 1"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
