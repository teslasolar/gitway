{
  "id": "pdf-viewer",
  "name": "PDF Viewer",
  "description": "Perspective PDF Viewer component - displays PDF files hosted on web server with page navigation",
  "version": "1.0.0",
  "author": "GitWay",
  "category": "Display",
  "parameters": {
    "source": {
      "type": "string",
      "required": true,
      "default": "",
      "description": "URL to PDF file hosted on web server (use Web Dev File Resource or Mounted Folder)",
      "example": "/system/webdev/resources/documents/manual.pdf"
    },
    "page": {
      "type": "number",
      "required": false,
      "default": 1,
      "description": "Currently displayed page number"
    },
    "showPageNumber": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Display current page number and total page count at bottom of component"
    }
  },
  "view": {
    "type": "pdfViewer",
    "props": {
      "source": "{{params.source}}",
      "page": "{{params.page}}",
      "pageCount": 0,
      "showPageNumber": "{{params.showPageNumber}}",
      "style": {
        "width": "100%",
        "height": "100%",
        "backgroundColor": "#525659",
        "border": "1px solid #d1d5db",
        "borderRadius": "4px"
      }
    },
    "children": [
      {
        "type": "conditional",
        "props": {
          "condition": "{{params.showPageNumber}}",
          "children": [
            {
              "type": "container",
              "props": {
                "style": {
                  "position": "absolute",
                  "bottom": "10px",
                  "left": "50%",
                  "transform": "translateX(-50%)",
                  "backgroundColor": "rgba(0, 0, 0, 0.7)",
                  "color": "#ffffff",
                  "padding": "5px 15px",
                  "borderRadius": "4px",
                  "fontSize": "14px",
                  "fontFamily": "Arial, sans-serif",
                  "zIndex": 1000
                }
              },
              "children": [
                {
                  "type": "text",
                  "props": {
                    "value": "Page {{this.parent.page}} of {{this.parent.pageCount}}",
                    "style": {
                      "color": "#ffffff"
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    ],
    "scripting": {
      "reload": {
        "description": "Reload the PDF in the PDF Viewer component",
        "parameters": [
          {
            "name": "pdfName",
            "type": "string",
            "description": "Name of the PDF to reload"
          }
        ],
        "example": "self.reload('manual.pdf')"
      }
    },
    "metadata": {
      "notes": [
        "PDF must be hosted on a web server (cannot display from local file system)",
        "Recommended: Use Web Dev File Resource or Mounted Folder for PDF hosting",
        "pageCount property is read-only and automatically updated",
        "page property can be bound to tag or set via script for navigation",
        "Use reload() function to refresh PDF content"
      ]
    }
  }
}
