{
  "id": "video-player",
  "name": "Video Player",
  "description": "Perspective Video Player component - embeds video or live feed from IP cameras with full playback controls",
  "version": "1.0.0",
  "author": "GitWay",
  "category": "Display",
  "parameters": {
    "source": {
      "type": "string",
      "required": true,
      "default": "",
      "description": "Path to video source or live feed URL",
      "example": "http://192.168.1.100/stream.mp4"
    },
    "liveFeed": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Toggle to display live feed - hides poster, autohideControls, controls, and status when true"
    },
    "poster": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Path to background image displayed before video loads (hidden if liveFeed is true)"
    },
    "autohideControls": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Control bar displays only on mouse hover when true (hidden if liveFeed is true)"
    },
    "autoplay": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Video begins playing when session loads (initially muted, requires mute on iOS)"
    },
    "loop": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Video plays repeatedly once completed"
    },
    "mute": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Video muted with no volume (must be true for autoplay on iOS)"
    },
    "play": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Enable/disable video playback (iOS requires user interaction)"
    },
    "seek": {
      "type": "number",
      "required": false,
      "default": 0,
      "description": "Starting playback time in seconds"
    },
    "volume": {
      "type": "number",
      "required": false,
      "default": 100,
      "description": "Volume level as percentage (0-100)"
    },
    "playRate": {
      "type": "number",
      "required": false,
      "default": 1,
      "description": "Playback speed (0.5 = half speed, 1 = normal, 2 = double speed)"
    }
  },
  "view": {
    "type": "videoPlayer",
    "props": {
      "source": "{{params.source}}",
      "liveFeed": "{{params.liveFeed}}",
      "poster": "{{params.liveFeed ? '' : params.poster}}",
      "autohideControls": "{{params.liveFeed ? false : params.autohideControls}}",
      "controls": {
        "autoplay": "{{params.autoplay}}",
        "loop": "{{params.loop}}",
        "mute": "{{params.mute}}",
        "play": "{{params.play}}",
        "seek": "{{params.seek}}",
        "volume": "{{params.volume}}",
        "playRate": "{{params.playRate}}"
      },
      "status": {
        "loadedData": false,
        "playing": false,
        "paused": true,
        "progress": 0,
        "rateChanged": 1,
        "seeking": false,
        "seeked": 0,
        "waiting": false,
        "ended": false
      },
      "style": {
        "width": "100%",
        "height": "100%",
        "backgroundColor": "#000000"
      },
      "controlStyle": {
        "controlBar": {
          "backgroundColor": "rgba(0, 0, 0, 0.7)",
          "color": "#ffffff"
        },
        "buttons": {
          "color": "#ffffff",
          "hoverColor": "#3b82f6"
        },
        "progressBar": {
          "backgroundColor": "#666666",
          "fillColor": "#3b82f6"
        },
        "volumeBar": {
          "backgroundColor": "#666666",
          "fillColor": "#3b82f6"
        }
      }
    },
    "metadata": {
      "notes": [
        "iOS devices require user interaction to play video - controls.play will not work",
        "Autoplay on iOS requires mute to be true (no audio)",
        "Fullscreen mode uses native browser player appearance",
        "Live feed mode hides poster, autohideControls, controls, and status properties",
        "Performance intensive - avoid embedding in Carousel component"
      ]
    }
  }
}
